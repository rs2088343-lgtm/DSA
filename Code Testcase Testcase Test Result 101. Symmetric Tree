/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
     // now we have to compair the root ,left,right to the root,right,left
   bool helper(TreeNode* le, TreeNode* ri){
         if(le == NULL && ri == NULL) return true ;
         // 2. If only one is null (or both aren't null, but one is), they don't match
         if (le == NULL || ri == NULL) return false;
         if(le->val != ri->val) return false ;
         
         return helper(le->right , ri->left) && helper(le->left , ri->right);
   }
    bool isSymmetric(TreeNode* root) {
        return helper(root->left , root->right);
    }
};
